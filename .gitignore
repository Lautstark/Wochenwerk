# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# Unused starter sample; Wochenwerk's design decisions live in docs/.
/examples/

# Locally licensed METACOM symbols are deliberately never committed.
# Nothing licensed is served from here any more: bildquelle reads the
# household's own folder through the File System Access API. See ADR 002.

# Terms that must never be committed. Kept out of the repository on purpose.
/.private-names
