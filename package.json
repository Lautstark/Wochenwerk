{
  "name": "wochenwerk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node ./node_modules/vite/bin/vite.js build",
    "start": "node ./node_modules/vite/bin/vite.js preview",
    "test": "node tools/no-private.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "preflight": "node node_modules/@lautstark/design/installcheck.mjs"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@lautstark/bildquelle": "github:Lautstark/bildquelle#v2.5.1",
    "@lautstark/design": "github:Lautstark/design#v1.43.0",
    "@lautstark/sicherung": "github:Lautstark/sicherung#v1.20.0",
    "@lautstark/stimmquelle": "github:Lautstark/stimmquelle#v2.15.0",
    "@lautstark/werkzeuge": "github:Lautstark/werkzeuge#v2.1.0",
    "idb": "^8.0.3",
    "onnxruntime-web": "^1.18.0"
  },
  "devDependencies": {
    "@lautstark/toolchain": "github:Lautstark/toolchain#v4.0.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^24.19.0",
    "fake-indexeddb": "^6.2.5",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6"
  },
  "type": "module"
}
